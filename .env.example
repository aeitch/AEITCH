# AEITCH Contact Form Environment Variables
# Copy this file to .env and configure your secrets

# Comma-separated list of recipient email addresses
CONTACT_RECIPIENTS="haseeb@aeitch.com,umer.khan@parkkaro.pk"

# The From address used to send inquiry notification emails
# Note: Must be on a verified domain with active SPF and DKIM records
CONTACT_FROM="AEITCH Website <no-reply@aeitch.com>"

# Email Provider Configuration:
# Option 1: Resend (Recommended)
RESEND_API_KEY=""

# Option 2: Custom SMTP (Alternative)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="465"
# SMTP_USER="apikey"
# SMTP_PASS=""
# SMTP_SECURE="true"
